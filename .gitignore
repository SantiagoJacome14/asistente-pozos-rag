# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de sistema
.DS_Store
Thumbs.db
*.tmp

# Logs
*.log
logs/

# Archivos temporales
*.bak
build/
dist/
*.egg-info/

# Variables de entorno
.env
.env.local
.env*.local

